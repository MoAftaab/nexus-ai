# Never expose this value to the browser. The FastAPI server reads it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true
# Optional: set a number to reproduce the same synthetic operation; omit for a new one each boot.
DEMO_SEED=
DATABASE_URL=sqlite:///./nexus.db
REDIS_URL=redis://localhost:6379/0
UPLOADS_DIR=./uploads
