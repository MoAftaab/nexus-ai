# Direct OpenAI configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# AgentRouter Claude fallback configuration (matching esbtr-prototype)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org
AGENTROUTER_MODEL=claude-opus-4-8

FRONTEND_URL=http://localhost:5173
DEMO_MODE=true
# Optional: set a number to reproduce the same synthetic operation; omit for a new one each boot.
DEMO_SEED=
DATABASE_URL=sqlite:///./nexus.db
REDIS_URL=redis://localhost:6379/0
UPLOADS_DIR=./uploads
